div className=\"text-xs font-bold uppercase tracking-wider text-[var(--text-3)] mb-1\">Vendor Notes</div>\n            <p className=\"text-sm text-[var(--text-2)]\">{quote.notes}</p>\n          </div>\n        )}\n\n        <RecordHistoryPanel\n          entityId={quote.id}\n          entityRef={quote.quoteNumber}\n          title=\"Supplier Quotation Activity & Audit Trail\"\n          subtitle=\"Pricing entry, revision updates, selection, approval, and PO conversion\"\n        />\n      </div>\n    </div>\n  );\n}\n"],"file":"/src/customer-app/src/procurement/proto/SupplierQuotationDetail.tsx"}