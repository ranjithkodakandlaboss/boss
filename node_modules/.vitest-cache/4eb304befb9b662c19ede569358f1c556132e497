AM,GAAK;;;;gBAAI,kGAAE,oDAAC,oCAAD,EAAa,MAAM,GAAK;;;;eAAC,iDAAC,QAAD,YAAM,WAAc;;;;aAAG;;;;;IACtF;;;;YACL;;;;;;EACA;;;;;;AAEX","names":[],"ignoreList":[],"sources":["Sidebar.tsx"],"sourcesContent":["import type { ReactNode } from \"react\";\nimport { NavLink, useLocation } from \"react-router-dom\";\nimport {\n  Home, Inbox, ShoppingCart, Package, Box, Activity, ShieldCheck,\n  Wrench, Truck, FileText, BarChart3, ChevronLeft, ChevronRight, Store, Landmark, Settings, History,\n} from \"lucide-react\";\nimport clsx from \"clsx\";\nimport { useShell } from \"../../shell/ShellContext\";\n\ninterface NavItem {\n  path: string;\n  label: string;\n  icon: ReactNode;\n}\n\nconst NAV_ITEMS: NavItem[] = [\n  { path: \"/\", label: \"Home\", icon: <Home size={17} /> },\n  { path: \"/inbox\", label: \"Inbox\", icon: <Inbox size={17} /> },\n  { path: \"/sales\", label: \"Sales & Orders\", icon: <ShoppingCart size={17} /> },\n  { path: \"/suppliers\", label: \"Suppliers\", icon: <Store size={17} /> },\n  { path: \"/procurement\", label: \"Procurement\", icon: <Package size={17} /> },\n  { path: \"/inventory\", label: \"Inventory\", icon: <Box size={17} /> },\n  { path: \"/jobs\", label: \"Production\", icon: <Activity size={17} /> },\n  { path: \"/quality\", label: \"Quality\", icon: <ShieldCheck size={17} /> },\n  { path: \"/assets\", label: \"Maintenance\", icon: <Wrench size={17} /> },\n  { path: \"/dispatch\", label: \"Dispatch\", icon: <Truck size={17} /> },\n  { path: \"/finance\", label: \"Finance\", icon: <Landmark size={17} /> },\n  { path: \"/documents\", label: \"Documents\", icon: <FileText size={17} /> },\n  { path: \"/reports\", label: \"Reports\", icon: <BarChart3 size={17} /> },\n  { path: \"/audit\", label: \"Audit Trail\", icon: <History size={17} /> },\n];\n\nfunction AuroraWave({ theme }: { theme: string }) {\n  const isOcean = theme === \"ocean\";\n  const isGraphite = theme === \"graphite\";\n  const c1 = isGraphite ? \"rgba(229,138,54,0.55)\" : isOcean ? \"rgba(8,127,140,0.60)\" : \"rgba(168,85,247,0.60)\";\n  const c2 = isGraphite ? \"rgba(245,158,11,0.30)\" : isOcean ? \"rgba(14,165,165,0.35)\" : \"rgba(112,72,245,0.35)\";\n  const c3 = isGraphite ? \"rgba(229,138,54,0.15)\" : isOcean ? \"rgba(8,127,140,0.18)\" : \"rgba(168,85,247,0.18)\";\n  const stopA = isGraphite ? \"#E58A36\" : isOcean ? \"#087F8C\" : \"#7048F5\";\n  const stopB = isGraphite ? \"#F59E0B\" : isOcean ? \"#0EA5A5\" : \"#A855F7\";\n  return (\n    <svg viewBox=\"0 0 216 90\" preserveAspectRatio=\"none\" className=\"absolute bottom-0 left-0 right-0 w-full pointer-events-none\" style={{ height: 90 }} aria-hidden=\"true\">\n      <defs>\n        <radialGradient id={`wg-${theme}`} cx=\"50%\" cy=\"110%\" r=\"75%\">\n          <stop offset=\"0%\" stopColor={stopA} stopOpacity=\"0.5\" />\n          <stop offset=\"55%\" stopColor={stopB} stopOpacity=\"0.2\" />\n          <stop offset=\"100%\" stopColor={stopA} stopOpacity=\"0\" />\n        </radialGradient>\n      </defs>\n      <path d=\"M-10 90 Q108 10 226 90 Z\" fill={`url(#wg-${theme})`} />\n      <path d=\"M-10 90 Q108 12 226 90\" stroke={c1} strokeWidth=\"2.5\" fill=\"none\" />\n      <path d=\"M-10 90 Q108 28 226 90\" stroke={c2} strokeWidth=\"1.8\" fill=\"none\" />\n      <path d=\"M-10 90 Q108 44 226 90\" stroke={c3} strokeWidth=\"1.2\" fill=\"none\" />\n    </svg>\n  );\n}\n\nexport default function Sidebar({ mobileOpen = false, onClose }: { mobileOpen?: boolean; onClose?: () => void }) {\n  const { collapsed: storedCollapsed, toggleCollapsed, palette } = useShell();\n  const location = useLocation();\n  const collapsed = storedCollapsed && !mobileOpen;\n  const sidebarBg = palette === \"graphite\"\n    ? \"linear-gradient(185deg, #232630 0%, #1F222B 40%, #13151C 100%)\"\n    : palette === \"ocean\"\n      ? \"linear-gradient(185deg, #123240 0%, #102D3A 40%, #071D27 100%)\"\n      : \"linear-gradient(185deg, #1E1B4B 0%, #191A4A 40%, #110C3A 100%)\";\n\n  return (\n    <aside\n      className={clsx(\n        \"fixed left-0 top-0 bottom-0 z-50 flex flex-col sidebar-transition select-none\",\n        mobileOpen ? \"flex\" : \"hidden md:flex\",\n        collapsed ? \"w-[var(--sidebar-w-collapsed,64px)]\" : \"w-[var(--sidebar-width,216px)]\",\n      )}\n      style={{ background: sidebarBg, borderRight: \"1px solid var(--sidebar-border, rgba(255,255,255,0.08))\" }}\n    >\n      <NavLink to=\"/\" end aria-label=\"Go to BOSS Home\" className={clsx(\"flex items-center flex-shrink-0 h-[64px] border-b hover:bg-white/5 transition-colors\", collapsed ? \"justify-center\" : \"px-4 gap-3\")} style={{ borderColor: \"var(--sidebar-border, rgba(255,255,255,0.08))\" }}>\n        <div className=\"w-8 h-8 flex-shrink-0 flex items-center justify-center relative\">\n          <div className=\"w-7 h-7 rounded-lg flex items-center justify-center shadow-md relative overflow-hidden\" style={{ background: \"linear-gradient(135deg, var(--brand), var(--brand-secondary, #A855F7))\" }}>\n            <div className=\"w-4 h-1.5 bg-white rounded-full -rotate-45 transform -translate-x-0.5 -translate-y-1 shadow-sm\" />\n            <div className=\"w-4 h-1.5 bg-white/90 rounded-full -rotate-45 transform translate-x-0.5 translate-y-1 shadow-sm\" />\n          </div>\n        </div>\n        {!collapsed && (\n          <div className=\"overflow-hidden leading-tight\">\n            <div className=\"text-base font-bold text-white tracking-tight\">BOSS</div>\n            <div className=\"text-[10px] font-medium text-white/60 tracking-normal whitespace-nowrap\">Business Operating Solution System</div>\n          </div>\n        )}\n      </NavLink>\n      <nav aria-label=\"Primary\" className=\"flex-1 overflow-y-auto py-2 px-2 space-y-0.5 relative z-10\">\n        {NAV_ITEMS.map((item) => {\n          const onApprovalsTab = location.pathname === \"/procurement\" && location.search.includes(\"tab=approvals\");\n          return (\n            <NavLink\n              key={item.path}\n              to={item.path}\n              end={item.path === \"/\"}\n              title={collapsed ? item.label : undefined}\n              onClick={onClose}\n              className={({ isActive }) => {\n                const active = item.path === \"/procurement\" ? isActive && !onApprovalsTab : isActive;\n                return clsx(\n                  \"flex items-center gap-3 rounded-xl transition-all duration-150 text-[13px] font-medium\",\n                  collapsed ? \"justify-center p-2 mx-auto w-9 h-9\" : \"px-3 py-2\",\n                  active ? \"text-white shadow-md\" : \"text-white/70 hover:text-white hover:bg-white/10\",\n                );\n              }}\n              style={({ isActive }) => {\n                const active = item.path === \"/procurement\" ? isActive && !onApprovalsTab : isActive;\n                return {\n                  background: active ? \"var(--sidebar-active-bg, linear-gradient(135deg, var(--brand), var(--brand-secondary)))\" : \"transparent\",\n                  boxShadow: active ? \"0 4px 14px -2px rgba(0, 0, 0, 0.3), inset 0 1px 1px rgba(255, 255, 255, 0.4)\" : undefined,\n                };\n              }}\n            >\n              <span className=\"flex-shrink-0\">{item.icon}</span>\n              {!collapsed && <span className=\"truncate\">{item.label}</span>}\n            </NavLink>\n          );\n        })}\n      </nav>\n      <div className=\"absolute bottom-0 left-0 right-0 h-[80px] overflow-hidden pointer-events-none z-0\" aria-hidden=\"true\">\n        <AuroraWave theme={palette} />\n      </div>\n      <div className=\"flex-shrink-0 px-2 py-1.5 border-t relative z-10 backdrop-blur-md\" style={{ borderColor: \"var(--sidebar-border, rgba(255,255,255,0.08))\", background: \"rgba(0,0,0,0.15)\" }}>\n        <NavLink\n          to=\"/admin\"\n          title={collapsed ? \"Admin & Settings\" : undefined}\n          onClick={onClose}\n          className={({ isActive }) => clsx(\n            \"flex items-center gap-3 rounded-xl transition-all duration-150 text-[13px] font-medium mb-1\",\n            collapsed ? \"justify-center p-2 mx-auto w-9 h-9\" : \"px-3 py-2\",\n            isActive ? \"text-white shadow-md\" : \"text-white/80 hover:text-white hover:bg-white/10\",\n          )}\n          style={({ isActive }) => ({\n            background: isActive ? \"var(--sidebar-active-bg, linear-gradient(135deg, var(--brand), var(--brand-secondary)))\" : \"transparent\",\n          })}\n        >\n          <span className=\"flex-shrink-0\"><Settings size={17} /></span>\n          {!collapsed && <span className=\"truncate font-semibold\">Admin & Settings</span>}\n        </NavLink>\n        <button\n          type=\"button\"\n          onClick={toggleCollapsed}\n          className={clsx(mobileOpen && \"hidden\", \"flex items-center gap-2 w-full rounded-lg px-2.5 py-1.5 text-xs font-medium text-white/60 hover:text-white hover:bg-white/10 transition-colors\", collapsed && \"justify-center\")}\n          title={collapsed ? \"Expand sidebar\" : \"Collapse sidebar\"}\n        >\n          {collapsed ? <ChevronRight size={14} /> : <><ChevronLeft size={14} /><span>Collapse</span></>}\n        </button>\n      </div>\n    </aside>\n  );\n}\n"],"file":"/src/customer-app/src/components/layout/Sidebar.tsx"}