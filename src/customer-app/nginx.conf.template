server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location /api/ {
    proxy_pass https://boss-api-dev-201664309080.asia-south1.run.app;
    proxy_ssl_server_name on;
    proxy_set_header Host boss-api-dev-201664309080.asia-south1.run.app;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }

  location /actuator/ {
    proxy_pass https://boss-api-dev-201664309080.asia-south1.run.app;
    proxy_ssl_server_name on;
    proxy_set_header Host boss-api-dev-201664309080.asia-south1.run.app;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
