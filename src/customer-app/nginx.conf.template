server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 50M;

  location /api/ {
    client_max_body_size 50M;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_pass https://boss-api-dev-201664309080.asia-south1.run.app;
    proxy_ssl_server_name on;
    proxy_set_header Host boss-api-dev-201664309080.asia-south1.run.app;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }

  location /actuator/ {
    proxy_pass https://boss-api-dev-201664309080.asia-south1.run.app;
    proxy_ssl_server_name on;
    proxy_set_header Host boss-api-dev-201664309080.asia-south1.run.app;
  }

  # Hashed bundles live under /static/. Do not directory-index /assets/,
  # because that path is also the Assets screen and a directory match hangs refresh.
  location /static/ {
    try_files $uri =404;
  }

  location / {
    try_files $uri /index.html;
  }
}
